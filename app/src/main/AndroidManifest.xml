<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TresEnRaya"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="false"/>

        <activity
            android:name=".PantallaDosJug"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".PantallaIntermediaMaquina"
            android:screenOrientation="portrait"
            android:exported="false" />


        <activity android:name=".PantallaTemas"
            android:screenOrientation="portrait"
            android:exported="false"/>

        <activity android:name=".PantallaIngresarNombreJugador"
            android:screenOrientation="portrait"
            android:exported="false"/>

        <!-- Pantalla de modos de juego -->
        <activity
            android:name=".PantallaModos"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Pantalla de ajustes -->
        <activity
            android:name=".PantallaAjustes"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Pantalla de estadísticas -->
        <activity
            android:name=".PantallaEstadisticas"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Pantalla principal de la aplicación -->
        <activity
            android:name=".PantallaHome"
            android:screenOrientation="portrait"
            android:exported="true">





        <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servicio de música de tu compañero -->
        <service
            android:name=".MusicaService"
            android:exported="false" />

        <!-- Pantalla mostrada al ganar, perder o empatar -->
        <activity
            android:name=".PantallaResultadoPartida"
            android:screenOrientation="portrait"
            android:exported="false" />




    </application>

</manifest>